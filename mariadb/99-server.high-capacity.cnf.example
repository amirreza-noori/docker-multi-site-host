# High-capacity sample for ~32g host with a primary WP site.
# Apply: copy over mariadb/conf.d/99-server.cnf then:
#   docker compose up -d --force-recreate mariadb
#
# RAM split suggestion (total ~32g):
#   OS + Docker ~2g | MariaDB ~10g (buffer pool below) | primary WP ~16–18g | other sites ~2–4g
# If WP mem_limit stays 28g, keep buffer_pool at 2–3G — DB becomes the bottleneck.
#
# Also set on the mariadb service in docker-compose.yml (optional but recommended):
#   mem_limit: 12g

[mysqld]
# All site FPM pools + backup + admin; 10000 wastes RAM per slot
max_connections = 500
max_allowed_packet = 256M

# InnoDB — main cache for tables/indexes (most important knob)
innodb_buffer_pool_size = 8G
innodb_buffer_pool_instances = 8
innodb_log_file_size = 1G
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000
innodb_read_io_threads = 8
innodb_write_io_threads = 8

tmp_table_size = 128M
max_heap_table_size = 128M
table_open_cache = 4000
table_definition_cache = 2000
thread_cache_size = 100

# Slow query log (tune threshold after go-live)
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2
