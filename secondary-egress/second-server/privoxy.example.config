# Privoxy on the second server (inbound egress mode).
listen-address  127.0.0.1:8118
toggle  1
enable-remote-toggle  0
enable-edit-actions 0
enforce-blocks 0
buffer-limit 8192
# Concurrent CONNECT/proxy clients (default 128 fills under sustained site traffic)
max-client-connections 512
keep-alive-timeout 5
socket-timeout 30
