# Copy to mail-router.env and edit before first start.

# Public hostname of this mail host (A/MX should point here; PTR recommended)
MAIL_HOSTNAME=mail.example.com

# Optional: force the IPv4 shown in SPF examples (auto-detected if empty)
# PUBLIC_IP=1.2.3.4

# Where SQLite + DKIM keys + pid live (created automatically)
DATA_DIR=/var/lib/mail-router

# Bind addresses — keep panel on localhost (SSH tunnel). Never expose PANEL on 0.0.0.0.
SMTP_BIND=0.0.0.0
SMTP_PORT=25
SUBMISSION_PORT=587
PANEL_BIND=127.0.0.1
PANEL_PORT=8088

# First boot only: used to create the admin account if DB is empty.
# Change immediately after login. Min 12 characters.
ADMIN_PASSWORD=change-me-now-please

# TLS for SMTP STARTTLS on submission :587 (required by most apps).
# Leave empty to auto-use Let's Encrypt for MAIL_HOSTNAME, or set explicitly:
TLS_CERT_FILE=/etc/letsencrypt/live/mail.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/mail.example.com/privkey.pem

# Offer STARTTLS on inbound MX port 25 as well (default yes).
INBOUND_STARTTLS=yes

# After N wrong panel passwords: lock ALL logins for M minutes (any IP)
PANEL_LOGIN_FAIL_MAX=3
PANEL_LOGIN_LOCK_MINUTES=10

# Anti-abuse defaults (overridable per sender in the panel)
DAILY_MESSAGE_QUOTA=100
DAILY_RECIPIENT_QUOTA=200
MAX_RECIPIENTS_PER_MESSAGE=10
MAX_MESSAGE_SIZE_BYTES=10485760

# Forward queue: retries then drop (mail is never stored as a mailbox)
QUEUE_MAX_ATTEMPTS=8
QUEUE_RETRY_SECONDS=120
QUEUE_TTL_SECONDS=86400

# If a listened address receives mail but no rule matches: discard | bounce
UNMATCHED_ACTION=discard

# Max Received hops / loop marker before reject
MAX_HOPS=20
