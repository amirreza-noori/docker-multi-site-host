#!/usr/bin/env bash
# Apply /etc/mail-smtp/mail-smtp.env into Postfix + OpenDKIM + Dovecot auth.
set -euo pipefail

ENV_FILE="${MAIL_SMTP_ENV:-/etc/mail-smtp/mail-smtp.env}"
CONF_DIR=/etc/mail-smtp

load_env() {
  set -a
  # shellcheck disable=SC1090
  source <(sed -e 's/\r$//' -e '/^#/d' -e '/^$/d' -e '/[<>]/d' "${ENV_FILE}" | while IFS= read -r line; do
    key="${line%%=*}"
    val="${line#*=}"
    printf 'export %s=%q\n' "${key}" "${val}"
  done)
  set +a
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "mail-smtp-apply: run as root" >&2
    exit 1
  fi
}

require_root
[[ -f "${ENV_FILE}" ]] || { echo "missing ${ENV_FILE}" >&2; exit 1; }
load_env

MAIL_HOSTNAME="${MAIL_HOSTNAME:?set MAIL_HOSTNAME in ${ENV_FILE}}"
TLS_MODE="${TLS_MODE:-letsencrypt}"
MAX_RECIPIENTS_PER_MESSAGE="${MAX_RECIPIENTS_PER_MESSAGE:-5}"
MAX_MESSAGE_SIZE_BYTES="${MAX_MESSAGE_SIZE_BYTES:-10485760}"
ANVIL_RATE_TIME_UNIT="${ANVIL_RATE_TIME_UNIT:-60s}"
CLIENT_MESSAGE_RATE="${CLIENT_MESSAGE_RATE:-10}"
CLIENT_RECIPIENT_RATE="${CLIENT_RECIPIENT_RATE:-20}"
CLIENT_CONNECTION_RATE="${CLIENT_CONNECTION_RATE:-20}"

# Do not call mail-smtp-cert on every apply (renewals are certbot.timer).
# If LE files are missing but CF_API_TOKEN is set, issue once.
if [[ "${TLS_MODE}" == "letsencrypt" ]]; then
  TLS_CERT_FILE="${TLS_CERT_FILE:-/etc/letsencrypt/live/${MAIL_HOSTNAME}/fullchain.pem}"
  TLS_KEY_FILE="${TLS_KEY_FILE:-/etc/letsencrypt/live/${MAIL_HOSTNAME}/privkey.pem}"
  if [[ ! -f "${TLS_CERT_FILE}" || ! -f "${TLS_KEY_FILE}" ]]; then
    if [[ -n "${CF_API_TOKEN:-}" && -x /usr/local/bin/mail-smtp-cert ]]; then
      echo "mail-smtp-apply: certificate missing — issuing via Cloudflare DNS once"
      /usr/local/bin/mail-smtp-cert
      load_env
      TLS_CERT_FILE="${TLS_CERT_FILE:-/etc/letsencrypt/live/${MAIL_HOSTNAME}/fullchain.pem}"
      TLS_KEY_FILE="${TLS_KEY_FILE:-/etc/letsencrypt/live/${MAIL_HOSTNAME}/privkey.pem}"
    fi
  fi
else
  TLS_CERT_FILE="${TLS_CERT_FILE:-/etc/ssl/certs/ssl-cert-snakeoil.pem}"
  TLS_KEY_FILE="${TLS_KEY_FILE:-/etc/ssl/private/ssl-cert-snakeoil.key}"
fi

if [[ ! -f "${TLS_CERT_FILE}" || ! -f "${TLS_KEY_FILE}" ]]; then
  echo "mail-smtp-apply: TLS cert missing. Set CF_API_TOKEN and ACME_EMAIL, then re-run install or mail-smtp-cert" >&2
  exit 1
fi

install -d -m 755 /etc/mail-smtp /etc/opendkim
# Quota DB for policy daemon (runs as nobody — must not need root-only env secrets)
install -d -o nobody -g nogroup -m 750 /var/lib/mail-smtp
if [[ -f /var/lib/mail-smtp/quota.db ]]; then
  chown nobody:nogroup /var/lib/mail-smtp/quota.db || true
fi
# Quotas only (no API tokens) — readable by policy spawn user
cat > /etc/mail-smtp/quota.conf <<EOF
DAILY_MESSAGE_QUOTA=${DAILY_MESSAGE_QUOTA:-100}
DAILY_RECIPIENT_QUOTA=${DAILY_RECIPIENT_QUOTA:-200}
EOF
chmod 644 /etc/mail-smtp/quota.conf
touch /etc/mail-smtp/accounts.list /etc/mail-smtp/passwd /etc/mail-smtp/sender_login_maps
touch /etc/opendkim/KeyTable /etc/opendkim/SigningTable
chmod 640 /etc/mail-smtp/passwd /etc/mail-smtp/accounts.list
chown root:dovecot /etc/mail-smtp/passwd 2>/dev/null || true
chown opendkim:opendkim /etc/opendkim/KeyTable /etc/opendkim/SigningTable 2>/dev/null || true

# --- Dovecot: auth only (no IMAP/POP) ---
cat > /etc/dovecot/conf.d/99-mail-smtp-auth.conf <<EOF
# mail-smtp: SASL auth for Postfix submission only
auth_mechanisms = plain login
service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}
passdb {
  driver = passwd-file
  args = scheme=SHA512-CRYPT username_format=%u ${CONF_DIR}/passwd
}
userdb {
  driver = static
  args = uid=vmail gid=vmail home=/var/lib/mail-smtp/home/%u
}
service imap-login {
  inet_listener imap {
    port = 0
  }
  inet_listener imaps {
    port = 0
  }
}
service pop3-login {
  inet_listener pop3 {
    port = 0
  }
  inet_listener pop3s {
    port = 0
  }
}
EOF

if ! id -u vmail >/dev/null 2>&1; then
  useradd --system --home /var/lib/mail-smtp/home --shell /usr/sbin/nologin vmail || true
fi
install -d -o vmail -g vmail -m 750 /var/lib/mail-smtp/home

# --- OpenDKIM (sign-only; inet socket avoids Postfix chroot permission issues) ---
install -d -m 755 /etc/opendkim
install -d -o opendkim -g opendkim -m 755 /run/opendkim
touch /etc/opendkim/KeyTable /etc/opendkim/SigningTable
chown opendkim:opendkim /etc/opendkim/KeyTable /etc/opendkim/SigningTable

cat > /etc/opendkim.conf <<'EOF'
Syslog			yes
Canonicalization	relaxed/simple
Mode			s
SubDomains		no
UserID			opendkim
Socket			inet:8891@127.0.0.1
PidFile			/run/opendkim/opendkim.pid
KeyTable		refile:/etc/opendkim/KeyTable
SigningTable		refile:/etc/opendkim/SigningTable
EOF

cat > /etc/default/opendkim <<EOF
RUNDIR=/run/opendkim
SOCKET="inet:8891@127.0.0.1"
USER=opendkim
GROUP=opendkim
PIDFILE=/run/opendkim/opendkim.pid
EXTRAAFTER=
EOF

# DKIM private keys must be owner-only; postfix must not share the opendkim group
gpasswd -d postfix opendkim 2>/dev/null || true
if [[ -d /etc/mail-smtp/dkim ]]; then
  chown -R opendkim:opendkim /etc/mail-smtp/dkim
  find /etc/mail-smtp/dkim -type d -exec chmod 700 {} \;
  find /etc/mail-smtp/dkim -name '*.private' -exec chmod 600 {} \;
fi

# --- Postfix main.cf ---
postconf -e "myhostname = ${MAIL_HOSTNAME}"
postconf -e "myorigin = ${MAIL_HOSTNAME}"
postconf -e "mydestination ="
postconf -e "local_recipient_maps ="
postconf -e "local_transport = error:local mail delivery is disabled"
postconf -e "mynetworks = 127.0.0.0/8 [::1]/128"
postconf -e "inet_interfaces = all"
postconf -e "inet_protocols = ipv4"
postconf -e "message_size_limit = ${MAX_MESSAGE_SIZE_BYTES}"
postconf -e "smtpd_recipient_limit = ${MAX_RECIPIENTS_PER_MESSAGE}"
postconf -e "anvil_rate_time_unit = ${ANVIL_RATE_TIME_UNIT}"
postconf -e "smtpd_client_connection_rate_limit = ${CLIENT_CONNECTION_RATE}"
postconf -e "smtpd_client_message_rate_limit = ${CLIENT_MESSAGE_RATE}"
postconf -e "smtpd_client_recipient_rate_limit = ${CLIENT_RECIPIENT_RATE}"
postconf -e "smtpd_tls_cert_file = ${TLS_CERT_FILE}"
postconf -e "smtpd_tls_key_file = ${TLS_KEY_FILE}"
postconf -e "smtpd_tls_security_level = may"
postconf -e "smtp_tls_security_level = may"
postconf -e "smtpd_sasl_type = dovecot"
postconf -e "smtpd_sasl_path = private/auth"
postconf -e "smtpd_sasl_auth_enable = yes"
postconf -e "smtpd_sasl_security_options = noanonymous"
postconf -e "smtpd_sasl_local_domain ="
postconf -e "broken_sasl_auth_clients = yes"
postconf -e "smtpd_sender_login_maps = hash:/etc/mail-smtp/sender_login_maps"
postconf -e "smtpd_sender_restrictions = reject_sender_login_mismatch"
postconf -e "milter_default_action = accept"
postconf -e "milter_protocol = 6"
postconf -e "smtpd_milters = inet:127.0.0.1:8891"
postconf -e "non_smtpd_milters = inet:127.0.0.1:8891"
postconf -e "smtpd_data_restrictions = reject_unauth_pipelining"
postconf -e "disable_vrfy_command = yes"
postconf -e "smtpd_helo_required = yes"
postconf -e "strict_rfc821_envelopes = yes"
# Policy via restriction classes (avoids spaces inside master.cf -o arguments)
postconf -e "smtpd_restriction_classes = mail_smtp_submit, mail_smtp_eod"
postconf -e "mail_smtp_submit = check_policy_service unix:private/mail-smtp-policy, permit_sasl_authenticated, reject"
postconf -e "mail_smtp_eod = check_policy_service unix:private/mail-smtp-policy"
postconf -e "smtpd_relay_restrictions = permit_mynetworks, check_policy_service unix:private/mail-smtp-policy, permit_sasl_authenticated, reject"
postconf -e "smtpd_recipient_restrictions = permit_mynetworks, check_policy_service unix:private/mail-smtp-policy, permit_sasl_authenticated, reject"
postconf -e "smtpd_end_of_data_restrictions = check_policy_service unix:private/mail-smtp-policy"

# Always refresh maps after account edits
postmap hash:/etc/mail-smtp/sender_login_maps

if [[ ! -f /etc/postfix/master.cf.mail-smtp.bak ]]; then
  cp -a /etc/postfix/master.cf /etc/postfix/master.cf.mail-smtp.bak
fi

python3 - <<'PY'
from pathlib import Path

path = Path("/etc/postfix/master.cf")
text = path.read_text(encoding="utf-8")
lines = text.splitlines(keepends=True)
out = []
i = 0
while i < len(lines):
    line = lines[i]
    stripped = line.lstrip("#")
    if (
        not line.startswith("#")
        and stripped.startswith("smtp ")
        and "inet" in line
        and "smtpd" in line
    ):
        out.append("# mail-smtp: inbound port 25 smtpd disabled (outbound SMTP client still works)\n")
        out.append("#" + line)
        i += 1
        while i < len(lines) and (lines[i].startswith(" ") or lines[i].startswith("\t")):
            out.append("#" + lines[i])
            i += 1
        continue
    out.append(line)
    i += 1

text2 = "".join(out)
marker = "### mail-smtp submission ###"
# No spaces inside -o values (Postfix splits on spaces → smtpd fatal)
block = f"""
{marker}
submission inet n       -       y       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_reject_unlisted_recipient=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=mail_smtp_submit
  -o smtpd_recipient_restrictions=mail_smtp_submit
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_end_of_data_restrictions=mail_smtp_eod
  -o milter_macro_daemon_name=ORIGINATING
smtps     inet  n       -       y       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_reject_unlisted_recipient=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=mail_smtp_submit
  -o smtpd_recipient_restrictions=mail_smtp_submit
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_end_of_data_restrictions=mail_smtp_eod
  -o milter_macro_daemon_name=ORIGINATING
mail-smtp-policy unix - n n - - spawn
  user=nobody argv=/usr/bin/python3 /usr/local/bin/mail-smtp-policy
"""

if marker in text2:
    start = text2.index(marker)
    start = text2.rfind("\n", 0, start) + 1
    text2 = text2[:start] + block.lstrip("\n")
else:
    text2 = text2.rstrip() + "\n" + block

path.write_text(text2, encoding="utf-8")
PY

systemctl enable dovecot postfix
systemctl restart dovecot
if ! systemctl restart opendkim; then
  echo "mail-smtp-apply: opendkim failed — /etc/opendkim.conf follows:" >&2
  nl -ba /etc/opendkim.conf >&2 || true
  systemctl status opendkim --no-pager -l || true
  journalctl -u opendkim -n 20 --no-pager || true
  echo "mail-smtp-apply: continuing without DKIM until fixed" >&2
else
  systemctl enable opendkim
fi
postfix check
systemctl restart postfix

echo "mail-smtp-apply: configuration applied for ${MAIL_HOSTNAME}"
