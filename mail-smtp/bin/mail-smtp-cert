#!/usr/bin/env bash
# Obtain / renew Let's Encrypt cert via Cloudflare DNS-01 only (automatic).
set -euo pipefail

ENV_FILE="${MAIL_SMTP_ENV:-/etc/mail-smtp/mail-smtp.env}"
CF_INI="${MAIL_SMTP_CF_INI:-/etc/mail-smtp/cloudflare.ini}"

load_env() {
  set -a
  # shellcheck disable=SC1090
  source <(sed -e 's/\r$//' -e '/^#/d' -e '/^$/d' -e '/[<>]/d' "${ENV_FILE}" | while IFS= read -r line; do
    key="${line%%=*}"
    val="${line#*=}"
    printf 'export %s=%q\n' "${key}" "${val}"
  done)
  set +a
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "mail-smtp-cert: run as root" >&2
    exit 1
  fi
}

set_env_tls_paths() {
  local cert="$1"
  local key="$2"
  local tmp
  tmp="$(mktemp)"
  grep -vE '^(TLS_CERT_FILE|TLS_KEY_FILE)=' "${ENV_FILE}" > "${tmp}" || true
  {
    cat "${tmp}"
    echo "TLS_CERT_FILE=${cert}"
    echo "TLS_KEY_FILE=${key}"
  } > "${ENV_FILE}"
  rm -f "${tmp}"
  chmod 600 "${ENV_FILE}"
}

install_deploy_hook() {
  install -d -m 755 /etc/letsencrypt/renewal-hooks/deploy
  cat > /etc/letsencrypt/renewal-hooks/deploy/mail-smtp.sh <<'EOF'
#!/usr/bin/env bash
# Reload Postfix after certbot renew (automatic via certbot.timer).
set -euo pipefail
if systemctl is-active --quiet postfix; then
  systemctl reload postfix
  logger -t mail-smtp-cert "postfix reloaded after certificate renew"
fi
EOF
  chmod 755 /etc/letsencrypt/renewal-hooks/deploy/mail-smtp.sh
}

write_cloudflare_ini() {
  if [[ -z "${CF_API_TOKEN:-}" ]]; then
    echo "mail-smtp-cert: set CF_API_TOKEN in ${ENV_FILE}" >&2
    echo "  Cloudflare token: Zone → DNS → Edit for the zone of MAIL_HOSTNAME" >&2
    exit 1
  fi
  umask 077
  cat > "${CF_INI}" <<EOF
# Written by mail-smtp-cert — do not commit
dns_cloudflare_api_token = ${CF_API_TOKEN}
EOF
  chmod 600 "${CF_INI}"
}

ensure_packages() {
  export DEBIAN_FRONTEND=noninteractive
  if ! command -v certbot >/dev/null 2>&1 \
    || ! dpkg -s python3-certbot-dns-cloudflare >/dev/null 2>&1; then
    apt-get update
    apt-get install -y certbot python3-certbot-dns-cloudflare
  fi
}

require_root
[[ -f "${ENV_FILE}" ]] || { echo "mail-smtp-cert: missing ${ENV_FILE}" >&2; exit 1; }
load_env

MAIL_HOSTNAME="${MAIL_HOSTNAME:?}"
TLS_MODE="${TLS_MODE:-letsencrypt}"
ACME_EMAIL="${ACME_EMAIL:-}"
CF_PROPAGATION_SECONDS="${CF_PROPAGATION_SECONDS:-30}"

if [[ "${TLS_MODE}" != "letsencrypt" ]]; then
  echo "mail-smtp-cert: TLS_MODE=${TLS_MODE} (skip Let's Encrypt)"
  exit 0
fi

if [[ -z "${ACME_EMAIL}" || "${ACME_EMAIL}" == *"example.com"* ]]; then
  echo "mail-smtp-cert: set ACME_EMAIL in ${ENV_FILE} to a real address" >&2
  exit 1
fi

ensure_packages
install_deploy_hook
write_cloudflare_ini

# Remove legacy HTTP-01 helper if present
systemctl disable --now mail-smtp-acme-http.service 2>/dev/null || true
rm -f /etc/systemd/system/mail-smtp-acme-http.service /usr/local/bin/mail-smtp-acme-http
systemctl daemon-reload 2>/dev/null || true

live_dir="/etc/letsencrypt/live/${MAIL_HOSTNAME}"
cert_file="${live_dir}/fullchain.pem"
key_file="${live_dir}/privkey.pem"

if [[ ! -f "${cert_file}" || ! -f "${key_file}" ]]; then
  echo "mail-smtp-cert: requesting certificate via Cloudflare DNS for ${MAIL_HOSTNAME}"
  certbot certonly \
    --dns-cloudflare \
    --dns-cloudflare-credentials "${CF_INI}" \
    --dns-cloudflare-propagation-seconds "${CF_PROPAGATION_SECONDS}" \
    --non-interactive \
    --agree-tos \
    --email "${ACME_EMAIL}" \
    -d "${MAIL_HOSTNAME}"
else
  echo "mail-smtp-cert: existing cert at ${live_dir} (renewal via certbot.timer)"
fi

[[ -f "${cert_file}" && -f "${key_file}" ]] || {
  echo "mail-smtp-cert: certificate files missing after certbot" >&2
  exit 1
}

set_env_tls_paths "${cert_file}" "${key_file}"
systemctl enable --now certbot.timer 2>/dev/null || true

echo "mail-smtp-cert: TLS_CERT_FILE=${cert_file}"
echo "mail-smtp-cert: TLS_KEY_FILE=${key_file}"
echo "mail-smtp-cert: auto-renew enabled (certbot.timer + postfix reload hook)"
