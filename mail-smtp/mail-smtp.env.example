# Copy to mail-smtp.env, fill CF_API_TOKEN + ACME_EMAIL, then run install.sh once.
# After that, certificates renew automatically (no manual commands).

# Public hostname of this SMTP host (A record DNS-only + PTR should match)
MAIL_HOSTNAME=mail.example.com

# Let's Encrypt via Cloudflare DNS-01 only (automatic issue + renew)
TLS_MODE=letsencrypt
ACME_EMAIL=admin@example.com

# Cloudflare API token: Zone → DNS → Edit (zone that hosts MAIL_HOSTNAME)
# https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
CF_PROPAGATION_SECONDS=30

# Filled automatically by mail-smtp-cert during install:
TLS_CERT_FILE=/etc/letsencrypt/live/mail.example.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/mail.example.com/privkey.pem

# --- Anti-abuse (transactional sending only; not for bulk / SEO / marketing blasts) ---

MAX_RECIPIENTS_PER_MESSAGE=5
MAX_MESSAGE_SIZE_BYTES=10485760

ANVIL_RATE_TIME_UNIT=60s
CLIENT_MESSAGE_RATE=10
CLIENT_RECIPIENT_RATE=20
CLIENT_CONNECTION_RATE=20

DAILY_MESSAGE_QUOTA=100
DAILY_RECIPIENT_QUOTA=200

REQUIRE_TLS_FOR_AUTH=yes
